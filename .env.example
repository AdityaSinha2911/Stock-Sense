PORT=5000
NODE_ENV=development
# Local MongoDB connection or MongoDB Atlas URI:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/stocksense?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/stocksense
JWT_SECRET=stocksense_jwt_secret_key_change_me_in_production
JWT_EXPIRES_IN=7d
