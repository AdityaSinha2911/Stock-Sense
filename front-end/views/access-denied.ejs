<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>403 Access Denied | StockSense IMS</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #f4f7f6;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .denied-card {
      max-width: 500px;
      border: 1px solid #e1e8e5;
      border-radius: 16px;
      background: #ffffff;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    }
  </style>
</head>
<body class="p-3">
  <main class="w-100">
    <div class="denied-card mx-auto p-4 p-sm-5 text-center">
      <div class="p-3 bg-danger-subtle text-danger rounded-circle d-inline-flex mb-3">
        <i class="bi bi-shield-lock-fill fs-1"></i>
      </div>
      <h1 class="h4 fw-bold text-dark mb-2">Access Denied (403)</h1>
      <p class="text-secondary small mb-3">
        Your current account role <strong class="text-dark"><%= userRole || 'Operator' %></strong> does not have permission to view or manage the <strong class="text-dark"><%= resourceName || 'this module' %></strong> section.
      </p>

      <div class="alert alert-light border small text-start mb-4 py-2 px-3">
        <div class="fw-semibold text-secondary mb-1"><i class="bi bi-info-circle text-primary me-1"></i> Required Access Roles:</div>
        <div class="d-flex flex-wrap gap-1">
          <% (requiredRoles || ['Warehouse Admin']).forEach(role => { %>
            <span class="badge bg-secondary-subtle text-secondary-emphasis"><%= role %></span>
          <% }) %>
        </div>
      </div>

      <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
        <a href="/dashboard" class="btn btn-success px-4 py-2 fw-medium small" style="border-radius: 8px;">
          <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
        </a>
        <a href="/logout" class="btn btn-outline-danger px-4 py-2 fw-medium small" style="border-radius: 8px;">
          <i class="bi bi-box-arrow-right me-1"></i> Switch Account
        </a>
      </div>
    </div>
  </main>
</body>
</html>
