<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Login | StockSense IMS</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>
		body {
			font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
			min-height: 100vh;
			background-color: #f4f7f6;
		}

		.login-card {
			max-width: 440px;
			border: 1px solid #e1e8e5;
			border-radius: 14px;
		}

		.brand-mark {
			color: #157347;
			letter-spacing: 0.02em;
		}
	</style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
	<main class="w-100">
		<section class="login-card bg-white shadow-sm mx-auto p-4 p-sm-5" aria-labelledby="login-title">
			<div class="text-center mb-4">
				<div class="brand-mark fw-bold fs-2 d-flex align-items-center justify-content-center gap-2">
					<i class="bi bi-boxes text-success"></i> Stock<span class="text-dark">Sense</span>
				</div>
				<h1 id="login-title" class="h4 mt-3 mb-1 fw-bold">Sign in to Warehouse</h1>
				<p class="text-secondary small mb-0">Enter your credentials to access the inventory system.</p>
			</div>

			<!-- Quick Fill Demo Banner -->
			<div class="alert alert-success bg-success-subtle border-success-subtle py-2 px-3 small d-flex align-items-center justify-content-between mb-3" style="border-radius: 8px;">
				<div>
					<i class="bi bi-key-fill text-success me-1"></i>
					<span class="fw-medium">Demo:</span> <code class="text-success fw-bold">admin@stocksense.io</code>
				</div>
				<button type="button" class="btn btn-sm btn-success py-0 px-2 small" id="autoFillBtn" style="font-size: 0.75rem;">Fill</button>
			</div>

			<% if (typeof error !== 'undefined' && error) { %>
				<div class="alert alert-danger py-2 px-3 small" role="alert" style="border-radius: 8px;">
					<i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
				</div>
			<% } %>

			<% if (typeof success !== 'undefined' && success) { %>
				<div class="alert alert-success py-2 px-3 small" role="alert" style="border-radius: 8px;">
					<i class="bi bi-check-circle-fill me-2"></i><%= success %>
				</div>
			<% } %>

			<form action="/login" method="POST">
				<div class="mb-3">
					<label for="email" class="form-label small fw-semibold">Email address</label>
					<div class="input-group">
						<span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
						<input type="email" class="form-control" id="email" name="email" autocomplete="email" placeholder="admin@stocksense.io" required>
					</div>
				</div>

				<div class="mb-3">
					<label for="password" class="form-label small fw-semibold">Password</label>
					<div class="input-group">
						<span class="input-group-text bg-light text-muted"><i class="bi bi-lock"></i></span>
						<input type="password" class="form-control" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
					</div>
				</div>

				<div class="d-flex justify-content-between align-items-center mb-4">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" checked>
						<label class="form-check-label small text-secondary" for="rememberMe">
							Keep me signed in
						</label>
					</div>
					<a href="#" class="link-success small text-decoration-none" onclick="alert('Demo password is: admin123'); return false;">Forgot Password?</a>
				</div>

				<button type="submit" class="btn btn-success w-100 py-2 fw-semibold shadow-sm" style="border-radius: 8px;">
					<i class="bi bi-box-arrow-in-right me-1"></i> Sign In to StockSense
				</button>
			</form>

			<p class="text-center text-secondary small mt-4 mb-0">
				Need an account?
				<a href="#" class="link-success fw-semibold text-decoration-none" data-bs-toggle="modal" data-bs-target="#signUpModal">Create Account</a>
			</p>
		</section>
	</main>

	<!-- Quick Sign Up Modal -->
	<div class="modal fade" id="signUpModal" tabindex="-1" aria-labelledby="signUpModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content border-0 shadow">
				<div class="modal-header border-bottom">
					<h5 class="modal-title fw-bold" id="signUpModalLabel"><i class="bi bi-person-plus text-success me-2"></i>Create Operator Account</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<form action="/login" method="POST">
					<div class="modal-body p-4">
						<div class="mb-3">
							<label class="form-label small fw-semibold">Full Name *</label>
							<input type="text" class="form-control" name="name" placeholder="e.g. Jordan Miller" required>
						</div>
						<div class="mb-3">
							<label class="form-label small fw-semibold">Work Email *</label>
							<input type="email" class="form-control" name="email" placeholder="jordan@company.com" required>
						</div>
						<div class="mb-3">
							<label class="form-label small fw-semibold">Role</label>
							<select class="form-select" name="role">
								<option value="Warehouse Admin">Warehouse Admin</option>
								<option value="Receiving Clerk">Receiving Clerk</option>
								<option value="Inventory Auditor">Inventory Auditor</option>
								<option value="Forklift Operator">Forklift Operator</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label small fw-semibold">Password *</label>
							<input type="password" class="form-control" name="password" placeholder="At least 6 characters" required>
						</div>
					</div>
					<div class="modal-footer border-top bg-light-subtle">
						<button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">Cancel</button>
						<button type="submit" class="btn btn-sm btn-success px-3">Register & Sign In</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script>
		document.getElementById('autoFillBtn').addEventListener('click', function () {
			document.getElementById('email').value = 'admin@stocksense.io';
			document.getElementById('password').value = 'admin123';
		});
	</script>
</body>
</html>
