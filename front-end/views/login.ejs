<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Login | StockSense</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
	<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
	<style>
		body {
			font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
			min-height: 100vh;
			background-color: #f4f7f6;
		}

		.login-card {
			max-width: 420px;
			border: 1px solid #e1e8e5;
			border-radius: 12px;
		}

		.brand-mark {
			color: #157347;
			letter-spacing: 0.02em;
		}
	</style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
	<main class="w-100">
		<section class="login-card bg-white shadow-sm mx-auto p-4 p-sm-5" aria-labelledby="login-title">
			<div class="text-center mb-4">
				<div class="brand-mark fw-bold fs-2 d-flex align-items-center justify-content-center gap-2">
					<i class="bi bi-boxes text-success"></i> StockSense
				</div>
				<h1 id="login-title" class="h4 mt-3 mb-2">Welcome back</h1>
				<p class="text-secondary mb-0">Sign in to manage your inventory.</p>
			</div>

			<% if (typeof error !== 'undefined' && error) { %>
				<div class="alert alert-danger py-2 small" role="alert">
					<i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
				</div>
			<% } %>

			<% if (typeof success !== 'undefined' && success) { %>
				<div class="alert alert-success py-2 small" role="alert">
					<i class="bi bi-check-circle-fill me-2"></i><%= success %>
				</div>
			<% } %>

			<form action="/login" method="post">
				<div class="mb-3">
					<label for="email" class="form-label">Email address</label>
					<input type="email" class="form-control" id="email" name="email" autocomplete="email" placeholder="name@company.com" required>
				</div>

				<div class="mb-2">
					<label for="password" class="form-label">Password</label>
					<input type="password" class="form-control" id="password" name="password" autocomplete="current-password" placeholder="••••••••" required>
				</div>

				<div class="d-flex justify-content-between align-items-center mb-4">
					<div class="form-check">
						<input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe">
						<label class="form-check-label small text-secondary" for="rememberMe">
							Remember me
						</label>
					</div>
					<a href="#" class="link-success small text-decoration-none">Forgot Password?</a>
				</div>

				<button type="submit" class="btn btn-success w-100 py-2 fw-semibold">Login</button>
			</form>

			<p class="text-center text-secondary small mt-4 mb-0">
				Don't have an account?
				<a href="#" class="link-success fw-semibold text-decoration-none">Sign Up</a>
			</p>
		</section>
	</main>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
